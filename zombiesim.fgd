@PointClass base(Targetname, Angles) studio("models/Humans/Group01/male_07.mdl") = zn_den_npc : "ZombieSim Den NPC"
[
    npc_name(string) : "Display name" : "" : "The name shown above the NPC and in the Services and trading windows. Empty uses the trader's or profession's name."
    animation(string) : "Animation sequence" : "" : "Optional sequence to play on this model. If unavailable, the default animation is tried."
    default_animation(string) : "Default animation sequence" : "idle_subtle" : "Fallback sequence if the selected animation is empty or unavailable. Empty uses the known idle-sequence fallbacks."
    profession(string) : "Profession" : "" : "A profession id from data_static (for example Chef, Doctor, Scientist). Empty for a trader who offers no services."
    service_level(integer) : "Service level" : 1 : "The profession level the NPC works at (1 to the level cap)."
    fees(string) : "Service fees" : "" : "Optional per-service cash fees, for example 'cook=5 treat=10'. Empty uses npcServiceFees from trade_definitions.json."
    trader(choices) : "Trade table" : "" : "The trader table from trade_definitions.json, or none." =
    [
        "" : "None"
        "general" : "General goods"
        "quartermaster" : "Quartermaster"
        "clinic" : "Clinic"
    ]
    model(studio) : "World model" : "models/Humans/Group01/male_07.mdl"
]

@PointClass base(Targetname, Angles) = zn_safezone_door : "ZombieSim Safe-Zone Door"
[
    role(choices) : "Door role" : "enter" : "Whether this door enters a safe zone from the city or exits a den." =
    [
        "enter" : "Enter safe zone"
        "exit" : "Exit safe zone"
    ]
    use_radius(float) : "Use radius" : "96" : "Maximum distance at which this door can be used or prompted."
]

@PointClass base(Targetname, Angles) = zn_safezone_arrival : "ZombieSim Safe-Zone Arrival"
[
]

@PointClass base(Targetname, Angles) = zn_prefab_anchor : "ZombieSim Prefab Anchor"
[
    prefab_tags(string) : "Required prefab tags" : "" : "Comma-separated tags. Every tag must match an explicitly exported prefab. Selection is deterministic per world cell and anchor."
    instance_local(choices) : "Placed inside a tile instance" : 0 : "Set Yes in tile templates. The ZombieSim generator emits the transformed world-space copy; the original local copy is ignored." =
    [
        0 : "No (placed directly in the map)"
        1 : "Yes (tile template)"
    ]
    input TriggerParticle(string) : "Trigger the one-shot particle with the specified prefab particle ID."
]

@PointClass base(Targetname, Angles) studio("models/player/group01/male_03.mdl") = zn_prefab_guard : "ZombieSim Guard"
[
    guard_name(string) : "Display name" : "Guard"
    model(studio) : "Clothing-compatible citizen model" : "models/player/group01/male_03.mdl"
    idle(string) : "Idle animation sequence" : "idle_all_01"
    weapon(choices) : "Weapon" : "pistol" =
    [
        "pistol" : "9mm handgun"
        "smg" : "HL2 SMG"
    ]
    range(float) : "Engagement range" : "1000" : "Must be positive and no greater than the selected weapon's range."
    shirt(string) : "Shirt finish ID" : "" : "Clothing catalogue shirt finish ID; blank uses the model's native appearance."
    pants(string) : "Pants finish ID" : "" : "Clothing catalogue pants finish ID; blank uses the model's native appearance."
    damage(string) : "Damage per shot override" : "" : "Positive number; blank uses the weapon's normal damage."
    fire_interval(string) : "Fire interval override (seconds per shot)" : "" : "At least 0.05 seconds; blank uses the weapon's normal cadence."
    spread(string) : "Accuracy override (shot spread)" : "" : "Non-negative engine spread; 0 is perfectly accurate. Blank uses the weapon's normal spread."
]

@SolidClass base(Targetname) = trigger_multiple : "ZombieSim Transition Gate"
[
    zm_transition_direction(choices) : "World exit direction" : "north" : "The cardinal world edge this gate travels through." =
    [
        "north" : "North"
        "east" : "East"
        "south" : "South"
        "west" : "West"
    ]
    zm_transition_mode(choices) : "Travel mode" : "any" : "The generated world exit mode required by this gate." =
    [
        "any" : "Any permitted mode"
        "road" : "Road"
        "highway" : "Motorway"
    ]
]
