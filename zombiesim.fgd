@PointClass base(Targetname, Angles) studio("models/Humans/Group01/male_07.mdl") = zn_den_npc : "ZombieSim Den NPC"
[
    npc_name(string) : "Display name" : "" : "The name shown above the NPC and in the Services and trading windows. Empty uses the trader's or profession's name."
    animation(string) : "Animation sequence" : "" : "Optional sequence to play on this model. If unavailable, the default animation is tried."
    default_animation(string) : "Default animation sequence" : "idle_subtle" : "Fallback sequence if the selected animation is empty or unavailable. Empty uses the known idle-sequence fallbacks."
    profession(string) : "Profession" : "" : "A profession id from data_static (for example Chef, Doctor, Scientist). Empty for a trader who offers no services."
    service_level(integer) : "Service level" : 1 : "The profession level the NPC works at (1 to the level cap)."
    fees(string) : "Service fees" : "" : "Optional per-service cash fees, for example 'cook=5 treat=10'. Empty uses npcServiceFees from trade_definitions.json."
    trader(choices) : "Trade table" : "" : "The trader table from trade_definitions.json, or none." =
    [
        "" : "None"
        "general" : "General goods"
        "quartermaster" : "Quartermaster"
        "clinic" : "Clinic"
    ]
    model(studio) : "World model" : "models/Humans/Group01/male_07.mdl"
]

@PointClass base(Targetname, Angles) = zn_safezone_door : "ZombieSim Safe-Zone Door"
[
    role(choices) : "Door role" : "enter" : "Whether this door enters a safe zone from the city or exits a den." =
    [
        "enter" : "Enter safe zone"
        "exit" : "Exit safe zone"
    ]
    use_radius(float) : "Use radius" : "96" : "Maximum distance at which this door can be used or prompted."
]

