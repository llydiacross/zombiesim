@PointClass base(Targetname) = zn_world_profile : "ZombieSim World Profile"
[
    world_profile(string) : "World data profile" : "city" : "Loads data_static/zombiesim_world.json for city, data_static/zombiesim_world_preview.json for preview, or data_static/zombiesim_world_<profile>.json for a custom profile."
    start_delay(float) : "Opening safe-room delay (seconds)" : "0" : "For a new player only, waits this long before changing to the generated world-origin safe room. Use this time for an opening intro."
]

@PointClass base(Targetname) = zn_tile_direction : "ZombieSim Tile Direction"
[
    direction(choices) : "Tile edge" : "south" : "The local tile edge containing this building's entrance. The building will be rotated so this edge aligns with an adjacent road, motorway, or concrete path, if one is present." =
    [
        "north" : "North"
        "east" : "East"
        "south" : "South"
        "west" : "West"
    ]
]

@PointClass base(Targetname) = zn_road_connection : "ZombieSim Road Connection"
[
    connection_type(choices) : "Generated road connection" : "none" : "Whether this marker also requests a road connection at its authored edge." =
    [
        "none" : "No connection"
        "t_junction" : "T-junction"
        "bus" : "Bus layby"
        "driveway" : "Driveway"
    ]
]

